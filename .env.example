# .env.example — Copy this to .env and fill in your real values
# NEVER commit .env to version control!

# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=schema_guard
DB_USER=postgres
DB_PASSWORD=your_password_here

DB_CONNECTION_STRING=postgresql://user:password@localhost:5432/schema_guard

# Email alerting (using SMTP)
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here    # Use an App Password, not your real password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=oncall@example.com              # Can be a list separated by commas
EMAIL_SUBJECT=Schema Drift Detected
